# Sanctum — Unraid deployment env, paste-and-go.
#
# Copy this into Compose Manager's "Stack env file" tab as-is. If you keep
# Sanctum's appdata under a path other than /mnt/user/appdata/sanctum/,
# fix the four *_PATH lines and SANCTUM_BUILD_CONTEXT below.
#
# The generic template in ../.env.example carries the full commentary and
# every optional knob. This file trims it to the Unraid happy-path.
#
# NEVER put a passphrase, key, or token in this file. By design (hard
# constraint 3 / ADR D-4) there is no env var that unlocks the vault.

# --- exposure (ADR D-12: LAN-only, never internet-forwarded) ----------------
# 0.0.0.0 binds on every LAN interface — reachable from phones/laptops on
# the same network. If you only want to reach Sanctum through the Unraid
# GUI's host (SSH tunnel, no LAN exposure), set this to 127.0.0.1.
SANCTUM_BIND_IP=0.0.0.0
# 8250 dodges the arr stack's usual 8080 collision.
SANCTUM_PORT=8250

# --- storage (host paths — the container-side paths are fixed in compose) ---
SANCTUM_INBOX_PATH=/mnt/user/appdata/sanctum/inbox
SANCTUM_VAULT_PATH=/mnt/user/appdata/sanctum/vault
# SANCTUM_NOTIFY_PATH is only needed for the optional Unraid host-script channel (RUNBOOK).

# tmpfs size for the live SQLite index + transient decrypt buffer. Must
# comfortably exceed the largest backup you expect to ingest (Tryst
# TRYSTBK1 max is 512 MiB by design).
SANCTUM_TMPFS_SIZE=1g

# --- build (Compose Manager keeps compose files OUTSIDE the repo) -----------
# The build context must point at where you cloned the repo, so
# `docker compose up --build` (which Compose Manager runs on Up) can find
# the Dockerfile. See RUNBOOK "Deploy → 3A".
SANCTUM_BUILD_CONTEXT=/mnt/user/appdata/sanctum/repo
SANCTUM_VERSION=dev
# Local image name for source builds. Without this, Compose Manager first tries
# to PULL ghcr.io/herbiewalker/sanctum:dev, which does not exist, and aborts.
# Once releases are published, delete this line and set SANCTUM_VERSION to a
# release (e.g. 0.1.0) to run the published image instead.
SANCTUM_IMAGE=sanctum

# --- behaviour --------------------------------------------------------------
SANCTUM_STALENESS_DAYS=30

# --- update notice (ADR D-19) -------------------------------------------------
# true = once a day, ask GitHub's public releases API whether a newer Sanctum
# exists and raise an Unraid notification + a banner after login. It only
# reports; you still pull the new image yourself. GitHub sees your IP.
SANCTUM_UPDATE_CHECK=false

# --- notifications (ADR D-20) -------------------------------------------------
# Paste one URL and Sanctum tells you when it is locked too long, a backup is
# stale or a verify fails. Examples (the URL is a credential; keep it here only):
#   ntfy://ntfy.sh/your-private-topic        ntfy+http://192.168.1.10:8081/sanctum
#   https://discord.com/api/webhooks/...     https://hooks.slack.com/services/...
# Then test:  docker exec sanctum /usr/local/bin/sanctum -notify-test
SANCTUM_NOTIFY_URL=

# --- runtime ----------------------------------------------------------------
SANCTUM_MEM_LIMIT=2G
SANCTUM_CPU_LIMIT=2.0
TZ=America/New_York
