# Sanctum — copy to .env and edit. The .env is gitignored.
#
# ############################################################################
# #  PATHS AND PORTS ONLY.                                                   #
# #                                                                          #
# #  Never put the vault passphrase, a key, or any secret in this file.      #
# #  That is hard constraint 3 (CLAUDE.md) and ADR D-4: the key exists only  #
# #  in process memory, typed by a human after every container start. A      #
# #  passphrase written here lands on the array, where the D-2 adversary --  #
# #  anyone on the LAN with file access -- can read it. There is no          #
# #  environment variable that unlocks the vault, by design.                 #
# ############################################################################

# --- exposure (ADR D-12: LAN only) ------------------------------------------
# Bind to the Unraid host's LAN IP, or keep 127.0.0.1 and reach it over the
# Unraid GUI's host. Do NOT set this to 0.0.0.0 and forward the port.
SANCTUM_BIND_IP=127.0.0.1
# Default 8250 to dodge common collisions on Unraid hosts running the arr
# stack — 8080 is taken by qBittorrent, SABnzbd, and others. Change to any
# free port; the container-internal port stays 8080 and the compose file
# maps ${SANCTUM_PORT}:8080.
SANCTUM_PORT=8250

# --- storage ----------------------------------------------------------------
# Where Syncthing/SMB/SAF drop .tryst files. Mounted read-only into the
# container; treated as fully untrusted input.
SANCTUM_INBOX_PATH=/mnt/user/appdata/sanctum/inbox

# Where the vault lives: opaque blobs + the sealed index. Ciphertext only.
SANCTUM_VAULT_PATH=/mnt/user/appdata/sanctum/vault

# tmpfs size. Must comfortably exceed the largest backup you expect to ingest,
# because the trial decrypt streams through it.
SANCTUM_TMPFS_SIZE=1g

# --- behaviour --------------------------------------------------------------
# Days before an owner's newest backup is considered stale and an alert fires.
SANCTUM_STALENESS_DAYS=30

# --- notifications (ADR D-20) -----------------------------------------------
# Paste ONE URL and Sanctum tells you when it is locked too long, a backup is
# stale or a verify fails. The URL is a credential: keep it here only.
#   ntfy://ntfy.sh/your-private-topic        ntfy+http://192.168.1.10:8081/sanctum
#   https://discord.com/api/webhooks/...     https://hooks.slack.com/services/...
# Test it:  docker exec sanctum /usr/local/bin/sanctum -notify-test
SANCTUM_NOTIFY_URL=

# --- update notice (ADR D-19) -----------------------------------------------
# true = once a day ask GitHub whether a newer release exists; reports only.
SANCTUM_UPDATE_CHECK=false

# --- retention --------------------------------------------------------------
# Keep at least the newest N backups per owner regardless of age.
SANCTUM_RETENTION_KEEP_MIN=3

# Prune backups older than this AND beyond the keep-min. 0 disables age pruning.
SANCTUM_RETENTION_MAX_AGE_DAYS=365

# --- scheduler cadences (all optional; defaults below match a home-lab pace)
# Full re-verification of every stored blob. 0 disables. Default 168h = weekly.
SANCTUM_VERIFY_EVERY_HOURS=168

# Retention pass cadence. Default daily.
SANCTUM_RETENTION_EVERY_HOURS=24

# Staleness / locked-since alert cadence. Default hourly.
SANCTUM_ALERT_EVERY_MINUTES=60

# Fire "vault has been locked" alert after this many hours locked. 0 disables.
SANCTUM_LOCKED_ALERT_AFTER_HOURS=24

# Debounce for the locked-since alert — survives restarts via state.json.
SANCTUM_LOCKED_ALERT_DEBOUNCE_HOURS=24

# --- runtime ----------------------------------------------------------------
SANCTUM_VERSION=dev

# Build context (Dockerfile lives at the repo root). Leave commented if your
# docker-compose.yml sits INSIDE the cloned repo. Set to an absolute path if
# you keep the compose file somewhere else (e.g. Compose Manager's project
# dir under /boot/config/plugins/compose.manager/projects/sanctum/).
# SANCTUM_BUILD_CONTEXT=/mnt/user/appdata/sanctum/repo
SANCTUM_MEM_LIMIT=2G
SANCTUM_CPU_LIMIT=2.0
TZ=America/New_York
